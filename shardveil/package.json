{
  "name": "shardveil",
  "version": "0.1.0",
  "private": true,
  "description": "Shardveil \u2014 an original online action RPG: authoritative Node server, PostgreSQL persistence, three.js client.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "node scripts/migrate.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:browser": "node tests/browser/smoke.mjs",
    "check": "node scripts/check-syntax.js",
    "assets:bake": "node scripts/bake-assets.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "pg": "8.23.1",
    "three": "0.186.1",
    "ws": "8.22.0"
  }
}
