# Copy to .env.local (never commit real values). All optional: unset = the feature stays off.

# Public URL used for canonicals, sitemap and Open Graph.
SITE_URL=https://www.rbtfishpro.ro
# Leave unset until the business details and legal pages are confirmed: the site then sends
# noindex + "Disallow: /". Set to true at launch. (Read at build time — rebuild after changing.)
SITE_INDEXABLE=

# Where orders / contact messages go: "resend" (e-mail) or "file" (JSON Lines on a disk).
# Unset → the APIs answer "not configured" and nothing is accepted.
ORDER_SINK=
CONTACT_SINK=
# resend: API key from resend.com, recipient(s) and a sender on a domain verified in Resend.
RESEND_API_KEY=
MAIL_TO=
MAIL_FROM=
# file: directory for orders.jsonl / contact.jsonl (VPS only — not Vercel/serverless).
DATA_DIR=

# Orders are refused while src/config/site.ts has catalog.pricesConfirmed = false.
# Set to true ONLY for testing with the example prices.
ALLOW_PLACEHOLDER_ORDERS=

# Client IP for rate limiting. On Vercel the platform header is used automatically.
# Behind your own nginx/Caddy that overwrites X-Real-IP: TRUST_X_REAL_IP=true.
# Otherwise: number of proxies that append to X-Forwarded-For.
TRUST_X_REAL_IP=
TRUSTED_PROXY_HOPS=1
