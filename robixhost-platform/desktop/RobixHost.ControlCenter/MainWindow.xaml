<Window x:Class="RobixHost.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RobixHost.ControlCenter" xmlns:vm="clr-namespace:RobixHost.Desktop.ViewModels;assembly=RobixHost.Desktop.Core"
        Title="RobixHost Control Center" Width="1280" Height="800" MinWidth="960" MinHeight="600" Icon="Assets/app-icon-256.png">
  <Window.Resources>
    <!-- Screens are chosen by view-model type: no code-behind navigation. -->
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
      <Border Style="{StaticResource Card}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
        <StackPanel>
          <Image Source="Assets/logo-horizontal-dark-96h.png" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"/>
          <TextBlock Text="{Binding [login.title], Source={StaticResource Loc}}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding [login.server], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/>
          <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
          <TextBlock Text="{Binding [login.username], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/>
          <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
          <TextBlock Text="{Binding [login.password], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/>
          <PasswordBox PasswordChanged="OnPasswordChanged" Margin="0,2,0,10"/>
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button Content="{Binding [login.button], Source={StaticResource Loc}}" Command="{Binding LoginCommand}" IsDefault="True"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
      <StackPanel Margin="24">
        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer Padding="24"><StackPanel>
        <TextBlock Text="{Binding [nav.dashboard], Source={StaticResource Loc}}" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}"/>
        <WrapPanel>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel>
            <TextBlock Text="{Binding [dash.health], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding HealthSummary}" FontSize="16" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding HealthMessages}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel><TextBlock Text="{Binding [dash.cpu], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding CpuText}" FontSize="24"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel><TextBlock Text="{Binding [dash.memory], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding MemoryText}" FontSize="20"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel><TextBlock Text="{Binding [dash.storage], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding StorageText}" FontSize="20"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel><TextBlock Text="{Binding [dash.uptime], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding UptimeText}" FontSize="20"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel>
            <TextBlock Text="{Binding [dash.allocated], Source={StaticResource Loc}}" Style="{StaticResource Muted}"/>
            <TextBlock Text="{Binding AllocatedCpuText}" TextWrapping="Wrap"/><TextBlock Text="{Binding AllocatedMemoryText}" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Width="260"><StackPanel>
            <TextBlock Text="VMs" Style="{StaticResource Muted}"/>
            <TextBlock><Run Text="{Binding RunningCount, Mode=OneWay}"/> <Run Text="{Binding [dash.running], Source={StaticResource Loc}, Mode=OneWay}"/></TextBlock>
            <TextBlock><Run Text="{Binding PausedCount, Mode=OneWay}"/> <Run Text="{Binding [dash.paused], Source={StaticResource Loc}, Mode=OneWay}"/></TextBlock>
            <TextBlock><Run Text="{Binding StoppedCount, Mode=OneWay}"/> <Run Text="{Binding [dash.stopped], Source={StaticResource Loc}, Mode=OneWay}"/></TextBlock>
          </StackPanel></Border>
        </WrapPanel>
        <TextBlock Text="{Binding [dash.failedJobs], Source={StaticResource Loc}}" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <DataGrid ItemsSource="{Binding FailedJobs}" MaxHeight="220"><DataGrid.Columns>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}"/><DataGridTextColumn Header="Error" Binding="{Binding ErrorCode}" Width="*"/>
        </DataGrid.Columns></DataGrid>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VmListViewModel}">
      <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{Binding [nav.vms], Source={StaticResource Loc}}" Style="{StaticResource H1}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
          <Button Content="{Binding [vms.refresh], Source={StaticResource Loc}}" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding [vms.empty], Source={StaticResource Loc}}" Style="{StaticResource Muted}">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <DataGrid ItemsSource="{Binding Items}"><DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="State" Binding="{Binding State}"/>
          <DataGridTextColumn Header="vCPU" Binding="{Binding VCpus}"/>
          <DataGridTextColumn Header="MB" Binding="{Binding MemoryMb}"/>
          <DataGridTemplateColumn Header="Actions" Width="420"><DataGridTemplateColumn.CellTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Button Content="{Binding [act.start], Source={StaticResource Loc}}" Command="{Binding StartCommand}"/>
              <Button Content="{Binding [act.shutdown], Source={StaticResource Loc}}" Command="{Binding ShutdownCommand}"/>
              <Button Content="{Binding [act.pause], Source={StaticResource Loc}}" Command="{Binding PauseCommand}"/>
              <Button Content="{Binding [act.resume], Source={StaticResource Loc}}" Command="{Binding ResumeCommand}"/>
              <Button Content="{Binding [act.stop], Source={StaticResource Loc}}" Command="{Binding StopCommand}" Background="{DynamicResource Danger}"/>
            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns></DataGrid>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AuditViewModel}">
      <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{Binding [nav.audit], Source={StaticResource Loc}}" Style="{StaticResource H1}"/>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{Binding [vms.refresh], Source={StaticResource Loc}}" Command="{Binding RefreshCommand}"/>
        <DataGrid ItemsSource="{Binding Events}"><DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding At}"/><DataGridTextColumn Header="Actor" Binding="{Binding Actor}"/>
          <DataGridTextColumn Header="Action" Binding="{Binding Action}"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
        </DataGrid.Columns></DataGrid>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CreateVpsViewModel}">
      <ScrollViewer Padding="24"><StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding [nav.createVps], Source={StaticResource Loc}}" Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding Step}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
        <TextBlock Text="Name" Style="{StaticResource Muted}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,8"/>
        <TextBlock Text="vCPU" Style="{StaticResource Muted}"/><TextBox Text="{Binding VCpus, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,8"/>
        <TextBlock Text="Memory (MB)" Style="{StaticResource Muted}"/><TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,8"/>
        <TextBlock Text="Disk (GB)" Style="{StaticResource Muted}"/><TextBox Text="{Binding DiskGb, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,8"/>
        <TextBlock Text="IP pool" Style="{StaticResource Muted}"/>
        <ComboBox ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}" DisplayMemberPath="Name" Margin="0,2,0,8"/>
        <ItemsControl ItemsSource="{Binding Errors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Danger}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <CheckBox Content="I confirm this creates a real VM on the host" IsChecked="{Binding IsConfirmed}" Margin="0,8"/>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4"/>
        <TextBlock Text="{Binding CurrentStepText}" Style="{StaticResource Muted}"/>
        <TextBlock Text="{Binding FailureDetail}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding LogLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Back" Command="{Binding BackCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/>
          <Button Content="Deploy" Command="{Binding DeployCommand}"/><Button Content="Retry" Command="{Binding RetryCommand}"/>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShellViewModel}">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConnectionText}" Style="{StaticResource Muted}" Margin="12"/>
            <Button DockPanel.Dock="Bottom" Content="Sign out" Command="{Binding SignOutCommand}" Margin="12,0,12,0"/>
            <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path=TitleKey, Converter={x:Static local:LocConverter.Instance}}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <ContentControl Content="{Binding CurrentPage}"/>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
        <Button Content="RO / EN" Click="OnToggleLanguage"/><Button Content="Dark / Light" Click="OnToggleTheme"/>
      </StackPanel>
      <ContentControl Content="{Binding Screen}"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding Dialogs.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" MaxWidth="420"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
