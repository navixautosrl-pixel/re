<?xml version="1.0" encoding="utf-8"?>
<!-- Sandbox note: api.nuget.org is not reachable from the dev workspace. The build uses only the
     .NET shared framework + system libsqlite3 (P/Invoke). On a normal dev machine you may add nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="./.nuget-local" />
  </packageSources>
</configuration>
