# Copy this file to .env.local (Next.js) and fill in real values.
# Never commit .env.local or any file with real secrets — see .gitignore.
# Vars prefixed NEXT_PUBLIC_ are shipped to the browser: only put things here
# that are safe for a visitor to read. Everything else stays server-only.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API, in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Only used in trusted server-side code
# that needs to intentionally act outside RLS (rare — most server code
# should still use the anon key + the user's session).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────
# Developers → API keys, in your Stripe dashboard. Use test-mode keys
# (sk_test_… / pk_test_…) until the app is ready to go live.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → your endpoint → Signing secret.
# Required to verify webhook authenticity — see .claude/skills/security/SKILL.md.
STRIPE_WEBHOOK_SECRET=

# ── 21st.dev (component search/generation MCP) ──────────────────────────
# Free key at https://21st.dev/mcp
API_KEY_21ST=

# ── Site ─────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap.ts, robots.ts, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Notes ────────────────────────────────────────────────────────────────
# The Supabase, Stripe, and Vercel MCP servers (see .mcp.json) authenticate
# via OAuth in the editor the first time they're used — they do NOT read
# any of the variables above. The variables above are for the deployed
# app's own runtime, a separate thing from Claude Code's MCP connections.
