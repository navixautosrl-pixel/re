{
  "mcpServers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": { "x-api-key": "${API_KEY_21ST}" }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "playwright-local": {
      "command": "./node_modules/.bin/playwright-mcp",
      "args": [
        "--browser=chromium",
        "--executable-path=/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        "--isolated",
        "--blocked-origins=http://169.254.169.254;https://169.254.169.254;http://169.254.170.2;https://169.254.170.2;http://169.254.170.23;https://169.254.170.23;http://metadata.google.internal;https://metadata.google.internal;http://metadata;https://metadata;http://metadata.azure.com;https://metadata.azure.com;http://100.100.100.200;https://100.100.100.200;http://[fd00:ec2::254];https://[fd00:ec2::254];http://[fd00:ec2::23];https://[fd00:ec2::23]"
      ]
    }
  }
}
