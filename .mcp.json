{
  "mcpServers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": { "x-api-key": "${API_KEY_21ST}" }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "stripe": {
      "type": "http",
      "url": "https://mcp.stripe.com"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "playwright-local": {
      "command": "./node_modules/.bin/playwright-mcp",
      "args": [
        "--browser=chromium",
        "--isolated",
        "--blocked-origins=http://169.254.169.254;https://169.254.169.254;http://metadata.google.internal;https://metadata.google.internal;http://metadata.azure.com;https://metadata.azure.com;http://100.100.100.200;http://[fd00:ec2::254]"
      ]
    }
  }
}
