# This site is a static export (output: "export" in next.config.ts) with
# no backend of its own — accounts, orders, invoicing, and support
# tickets all live in WHMCS at clienti.robixhost.ro. There is currently
# nothing this build reads from the environment at runtime; this file is
# kept only in case a future addition needs one.

NEXT_PUBLIC_SITE_URL=https://robixhost.ro
