# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Nothing in this app currently reads these at runtime — the domain
# search, contact form, and pricing/checkout are intentionally UI-only
# placeholders (see ConfigBadge markers across the site). This file
# documents what's needed once each integration is actually connected.

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://robixhost.ro

# ── Supabase (planned: accounts, orders, ticket system) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (planned: plan checkout) ─────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Domain registrar (planned: /domains search + registration) ──────────
# Provider not yet chosen — add its API key here once selected.
DOMAIN_REGISTRAR_API_KEY=

# ── Contact / support form delivery (planned) ───────────────────────────
# e.g. Resend, Postmark, or a ticketing system's API key.
CONTACT_FORM_PROVIDER_API_KEY=

# ── Analytics (planned — must stay behind cookie consent, see
#    src/hooks/useCookieConsent.ts and CLAUDE.md) ───────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
